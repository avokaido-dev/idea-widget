{
  "name": "avokaido-idea-widget",
  "version": "1.0.0",
  "description": "Embeddable suggestion widget \u2014 one script tag opens a hosted interview that turns \"this is wrong, look\" into a feature request your team can act on.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./v1.js": "./dist/v1.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "types",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "feedback",
    "feature-requests",
    "widget",
    "embed",
    "suggestions",
    "product-feedback"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/avokaido-dev/idea-widget"
  },
  "homepage": "https://github.com/avokaido-dev/idea-widget#readme",
  "bugs": {
    "url": "https://github.com/avokaido-dev/idea-widget/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
